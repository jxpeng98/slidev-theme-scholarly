{
  "name": "slidev-scholarly-snippets",
  "displayName": "Slidev Scholarly",
  "description": "%extension.description%",
  "version": "1.4.1",
  "publisher": "jxpeng98",
  "icon": "images/icon-256.png",
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "Snippets",
    "Other"
  ],
  "keywords": [
    "slidev",
    "slides",
    "presentation",
    "academic",
    "scholarly",
    "markdown",
    "bibtex"
  ],
  "activationEvents": [
    "onLanguage:markdown",
    "onView:scholarly-layouts",
    "onView:scholarly-components",
    "onView:scholarly-templates",
    "onView:scholarly-themes",
    "onView:scholarly-cli",
    "onView:scholarly-references",
    "onCommand:slidev-scholarly.newPresentation",
    "onCommand:slidev-scholarly.applyThemePreset",
    "onCommand:slidev-scholarly.setColorTheme",
    "onCommand:slidev-scholarly.setFontTheme",
    "onCommand:slidev-scholarly.setContentMode",
    "onCommand:slidev-scholarly.setChromeMode",
    "onCommand:slidev-scholarly.setSectionMode",
    "onCommand:slidev-scholarly.setColorMode",
    "onCommand:slidev-scholarly.openSidebar",
    "onCommand:slidev-scholarly.openGuiBuilder",
    "onCommand:slidev-scholarly.cliAction",
    "onCommand:slidev-scholarly.cliMenu",
    "onCommand:slidev-scholarly.toggleDevMode",
    "onCommand:slidev-scholarly.refreshReferences",
    "onCommand:slidev-scholarly.insertPaperSummary",
    "onCommand:slidev-scholarly.insertInternalAnchor",
    "onCommand:slidev-scholarly.insertAnchorReference",
    "onCommand:slidev-scholarly.preview"
  ],
  "main": "./out/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "slidev-scholarly",
          "title": "Slidev Scholarly",
          "icon": "images/slidev-icon.svg"
        }
      ]
    },
    "views": {
      "slidev-scholarly": [
        {
          "id": "scholarly-templates",
          "name": "%view.templates%",
          "icon": "$(new-file)"
        },
        {
          "id": "scholarly-layouts",
          "name": "%view.layouts%",
          "icon": "$(layout)"
        },
        {
          "id": "scholarly-components",
          "name": "%view.components%",
          "icon": "$(symbol-method)"
        },
        {
          "id": "scholarly-references",
          "name": "%view.references%",
          "icon": "$(book)"
        },
        {
          "id": "scholarly-themes",
          "name": "%view.themes%",
          "icon": "$(paintcan)"
        },
        {
          "id": "scholarly-cli",
          "name": "%view.cli%",
          "icon": "$(terminal)"
        },
        {
          "type": "webview",
          "id": "scholarly-preview",
          "name": "%view.preview%",
          "icon": "$(eye)",
          "visibility": "hidden"
        }
      ]
    },
    "commands": [
      {
        "command": "slidev-scholarly.insertLayout",
        "title": "%command.insertLayout%",
        "category": "Slidev Scholarly",
        "icon": "$(add)"
      },
      {
        "command": "slidev-scholarly.insertComponent",
        "title": "%command.insertComponent%",
        "category": "Slidev Scholarly",
        "icon": "$(add)"
      },
      {
        "command": "slidev-scholarly.newPresentation",
        "title": "%command.createPresentation%",
        "category": "Slidev Scholarly",
        "icon": "$(new-file)"
      },
      {
        "command": "slidev-scholarly.insertCitation",
        "title": "%command.insertCitation%",
        "category": "Slidev Scholarly",
        "icon": "$(quote)"
      },
      {
        "command": "slidev-scholarly.insertInternalAnchor",
        "title": "%command.insertAnchor%",
        "category": "Slidev Scholarly",
        "icon": "$(symbol-key)"
      },
      {
        "command": "slidev-scholarly.insertAnchorReference",
        "title": "%command.insertAnchorReference%",
        "category": "Slidev Scholarly",
        "icon": "$(link)"
      },
      {
        "command": "slidev-scholarly.insertBibKey",
        "title": "%command.insertBibKey%",
        "category": "Slidev Scholarly",
        "icon": "$(add)"
      },
      {
        "command": "slidev-scholarly.insertPaperSummary",
        "title": "%command.insertPaperSummary%",
        "category": "Slidev Scholarly",
        "icon": "$(file-text)"
      },
      {
        "command": "slidev-scholarly.insertAnchorKey",
        "title": "%command.insertAnchorKey%",
        "category": "Slidev Scholarly",
        "icon": "$(link)"
      },
      {
        "command": "slidev-scholarly.applyThemePreset",
        "title": "%command.applyThemePreset%",
        "category": "Slidev Scholarly",
        "icon": "$(wand)"
      },
      {
        "command": "slidev-scholarly.setColorTheme",
        "title": "%command.setColorTheme%",
        "category": "Slidev Scholarly",
        "icon": "$(symbol-color)"
      },
      {
        "command": "slidev-scholarly.setFontTheme",
        "title": "%command.setFontTheme%",
        "category": "Slidev Scholarly",
        "icon": "$(text-size)"
      },
      {
        "command": "slidev-scholarly.setContentMode",
        "title": "%command.setContentMode%",
        "category": "Slidev Scholarly",
        "icon": "$(color-mode)"
      },
      {
        "command": "slidev-scholarly.setChromeMode",
        "title": "%command.setChromeMode%",
        "category": "Slidev Scholarly",
        "icon": "$(layout-menubar)"
      },
      {
        "command": "slidev-scholarly.setSectionMode",
        "title": "%command.setSectionMode%",
        "category": "Slidev Scholarly",
        "icon": "$(split-vertical)"
      },
      {
        "command": "slidev-scholarly.openSidebar",
        "title": "%command.openSidebar%",
        "category": "Slidev Scholarly",
        "icon": "$(layout-sidebar-left)"
      },
      {
        "command": "slidev-scholarly.openGuiBuilder",
        "title": "%command.openDeckBuilder%",
        "category": "Slidev Scholarly",
        "icon": "$(layout)"
      },
      {
        "command": "slidev-scholarly.refreshReferences",
        "title": "%command.refreshReferences%",
        "category": "Slidev Scholarly",
        "icon": "$(refresh)"
      },
      {
        "command": "slidev-scholarly.cliAction",
        "title": "%command.runCliAction%",
        "category": "Slidev Scholarly",
        "icon": "$(terminal)"
      },
      {
        "command": "slidev-scholarly.cliMenu",
        "title": "%command.openCliActions%",
        "category": "Slidev Scholarly",
        "icon": "$(terminal-bash)"
      },
      {
        "command": "slidev-scholarly.toggleDevMode",
        "title": "%command.toggleDevMode%",
        "category": "Slidev Scholarly",
        "icon": "$(debug)"
      },
      {
        "command": "slidev-scholarly.preview",
        "title": "%command.previewItem%",
        "category": "Slidev Scholarly",
        "icon": "$(eye)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "slidev-scholarly.refreshReferences",
          "when": "view == scholarly-references",
          "group": "navigation"
        },
        {
          "command": "slidev-scholarly.insertAnchorReference",
          "when": "view == scholarly-references",
          "group": "navigation@2"
        },
        {
          "command": "slidev-scholarly.insertInternalAnchor",
          "when": "view == scholarly-references",
          "group": "navigation@3"
        },
        {
          "command": "slidev-scholarly.applyThemePreset",
          "when": "view == scholarly-themes",
          "group": "navigation"
        },
        {
          "command": "slidev-scholarly.setColorTheme",
          "when": "view == scholarly-themes",
          "group": "navigation"
        },
        {
          "command": "slidev-scholarly.setFontTheme",
          "when": "view == scholarly-themes",
          "group": "navigation"
        },
        {
          "command": "slidev-scholarly.setContentMode",
          "when": "view == scholarly-themes",
          "group": "navigation"
        },
        {
          "command": "slidev-scholarly.setChromeMode",
          "when": "view == scholarly-themes",
          "group": "navigation"
        },
        {
          "command": "slidev-scholarly.setSectionMode",
          "when": "view == scholarly-themes",
          "group": "navigation"
        },
        {
          "command": "slidev-scholarly.openGuiBuilder",
          "when": "view == scholarly-templates",
          "group": "navigation"
        },
        {
          "command": "slidev-scholarly.cliMenu",
          "when": "view == scholarly-cli",
          "group": "navigation"
        },
        {
          "command": "slidev-scholarly.toggleDevMode",
          "when": "view == scholarly-cli",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "slidev-scholarly.insertLayout",
          "when": "view == scholarly-layouts && viewItem == layoutSnippet",
          "group": "inline@1"
        },
        {
          "command": "slidev-scholarly.preview",
          "when": "view == scholarly-layouts && viewItem == layoutSnippet",
          "group": "inline@2"
        },
        {
          "command": "slidev-scholarly.insertComponent",
          "when": "view == scholarly-components && viewItem == componentSnippet",
          "group": "inline@1"
        },
        {
          "command": "slidev-scholarly.preview",
          "when": "view == scholarly-components && viewItem == componentSnippet",
          "group": "inline@2"
        },
        {
          "command": "slidev-scholarly.preview",
          "when": "view == scholarly-themes && viewItem =~ /^theme/",
          "group": "inline"
        },
        {
          "command": "slidev-scholarly.insertBibKey",
          "when": "view == scholarly-references && viewItem == referenceCitation",
          "group": "inline"
        },
        {
          "command": "slidev-scholarly.insertPaperSummary",
          "when": "view == scholarly-references && viewItem == referenceCitation",
          "group": "inline@2"
        },
        {
          "command": "slidev-scholarly.insertAnchorKey",
          "when": "view == scholarly-references && viewItem == referenceAnchor",
          "group": "inline"
        }
      ]
    },
    "snippets": [
      {
        "language": "markdown",
        "path": "./snippets/layouts.vscode.json"
      },
      {
        "language": "markdown",
        "path": "./snippets/components.vscode.json"
      }
    ],
    "configuration": {
      "title": "Slidev Scholarly",
      "properties": {
        "slidevScholarly.devMode.enabled": {
          "type": "boolean",
          "default": false,
          "description": "%config.devMode%"
        },
        "slidevScholarly.devMode.slowThresholdMs": {
          "type": "number",
          "default": 25,
          "minimum": 1,
          "description": "%config.slowThreshold%"
        }
      }
    }
  },
  "scripts": {
    "sync-shared-data": "node ./scripts/sync-shared-data.mjs",
    "sync-previews": "node ./scripts/sync-previews.mjs",
    "sync-snippets": "node ./scripts/sync-snippets.mjs",
    "vscode:prepublish": "npm run sync-previews && npm run sync-snippets && npm run compile",
    "compile": "npm run sync-shared-data && npm run sync-snippets && tsc -p ./",
    "watch": "npm run sync-shared-data && npm run sync-snippets && tsc -watch -p ./",
    "test": "node --test test/*.test.mjs",
    "lint": "eslint src --ext ts",
    "package": "vsce package",
    "publish": "vsce publish",
    "publish:pre": "vsce publish --pre-release"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/vscode": "1.106.0",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "@vscode/vsce": "3.9.2",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jxpeng98/slidev-theme-scholarly"
  }
}
