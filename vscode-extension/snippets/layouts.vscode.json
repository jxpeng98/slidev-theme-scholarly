    "description": "[Structure] Centered content"
  },
  "Slidev Scholarly: Auto Center Layout": {
    "prefix": "ss-auto-center",
    "body": [
      "---",
      "layout: auto-center",
      "title: ${1:Title}",
      "subtitle: ${2:Subtitle}",
      "---",
      "",
      "## ${3:Auto-Centered Content}",
      "",
      "${4:Content with auto-adjusting font size.}",
      "",
      "$0"
    ],
    "description": "[Structure] Auto-adjusting centered content"
  },
  "Slidev Scholarly: Auto Size Layout": {
    "prefix": "ss-auto-size",
    "body": [
      "---",
      "layout: auto-size",
      "title: ${1:Title}",
      "subtitle: ${2:Subtitle}",
      "autoSizeGrow: ${3|true,false|}",
      "autoSizeAlign: ${4|top,center|}",
      "autoSizePadding: ${5|normal,compact|}",
      "minFontSize: ${6:14}",
      "maxFontSize: ${7:30}",
      "---",
      "",
      "## ${8:Auto-Sized Main Matter}",
      "",
      "${9:Content that should fit the available width and height.}",
      "",
      "$0"
    ],
    "description": "[Structure] Default flow with fit-to-page sizing"
  },
  "Slidev Scholarly: End Layout": {
    "prefix": "ss-end",
    "body": [
      "---",
      "layout: end",
      "email: ${1:your@email.com}",
      "website: ${2:https://example.com}",
      "subtitle: ${3:Questions?}",
      "---",
      "",
      "${4:Thank you for your attention!}",
      "",
      "$0"
    ],
    "description": "[Structure] Closing slide with contact info"
  },
  "_comment_content": "=== CONTENT LAYOUTS ===",
  "Slidev Scholarly: Two Columns Layout": {
    "prefix": "ss-two-cols",
    "body": [
      "---",
      "layout: two-cols",
      "ratio: \"${1|1:1,2:3,3:2,1:2,2:1|}\"",
      "title: ${2:Two Columns}",
      "---",
      "",
      "## ${3:Left Column}",
      "",
      "${4:Left content}",
      "",
      "::right::",
      "",
      "## ${5:Right Column}",
      "",
      "${6:Right content}",
      "",
      "$0"
    ],
    "description": "[Content] Two column layout"
  },
  "Slidev Scholarly: Image Left Layout": {
    "prefix": "ss-image-left",
    "body": [
      "---",
      "layout: image-left",
      "image: ${1:https://example.com/image.jpg}",
      "ratio: \"${2|1:2,1:1,1:3|}\"",
      "title: ${3:Image Left}",
      "---",
      "",
      "## ${4:Content Title}",
      "",
      "${5:Your content on the right side.}",
      "",
      "$0"
