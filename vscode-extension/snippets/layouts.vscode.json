  "_comment_academic": "=== ACADEMIC LAYOUTS ===",
  "Slidev Scholarly: Paper Summary Layout": {
    "prefix": "ss-paper-summary",
    "body": [
      "---",
      "layout: paper-summary",
      "title: ${1:Paper Summary}",
      "paperTitle: ${2:Title of the paper}",
      "authors:",
      "  - ${3:First Author}",
      "  - ${4:Second Author}",
      "venue: ${5:Conference or Journal}",
      "year: ${6:2026}",
      "keywords:",
      "  - ${7:keyword}",
      "---",
      "",
      "::problem::",
      "${8:What gap or question does the paper address?}",
      "",
      "::method::",
      "${9:What method or evidence does it use?}",
      "",
      "::finding::",
      "${10:What is the main result or takeaway?}",
      "",
      "$0"
    ],
    "description": "[Academic] Paper summary with metadata and takeaways"
  },
  "Slidev Scholarly: Related Work Matrix Layout": {
    "prefix": "ss-related-work-matrix",
    "body": [
      "---",
      "layout: related-work-matrix",
      "title: ${1:Related Work}",
      "description: ${2:Position the current work against prior approaches.}",
      "---",
      "",
      "| Work | Setting | Method | Limitation |",
      "| --- | --- | --- | --- |",
      "| ${3:Smith et al. 2024} | ${4:Benchmark} | ${5:Transformer baseline} | ${6:High compute cost} |",
      "| ${7:Ours} | ${8:Same benchmark} | **${9:Efficient adaptation}** | ${10:Requires task labels} |",
      "",
      "::notes::",
      "${11:Use the matrix to make the gap explicit before introducing your method.}",
      "",
      "$0"
    ],
    "description": "[Academic] Related-work comparison matrix"
  },
  "Slidev Scholarly: Method Pipeline Layout": {
    "prefix": "ss-method-pipeline",
    "body": [
      "---",
      "layout: method-pipeline",
      "title: ${1:Method Pipeline}",
      "description: ${2:Show the research workflow from input to validated output.}",
      "activeStep: ${3:2}",
      "steps:",
      "  - title: ${4:Collect}",
      "    description: ${5:Curate the dataset and constraints}",
      "    detail: ${6:N=12k samples}",
      "  - title: ${7:Model}",
      "    description: ${8:Train the proposed architecture}",
      "    detail: ${9:3 ablations}",
      "  - title: ${10:Validate}",
      "    description: ${11:Compare against baselines}",
      "    detail: ${12:5 seeds}",
      "---",
      "",
      "${13:Optional note about assumptions, controls, or reproducibility.}",
      "",
      "$0"
    ],
    "description": "[Academic] Method pipeline with step cards"
  },
  "Slidev Scholarly: Result Highlight Layout": {
    "prefix": "ss-result-highlight",
    "body": [
      "---",
      "layout: result-highlight",
      "title: ${1:Main Result}",
      "heading: ${2:Our method improves accuracy without extra compute}",
      "description: ${3:Lead with the claim, then use the metric and evidence to support it.}",
      "label: ${4:Accuracy}",
      "metric: ${5:94.7}",
      "unit: ${6:%}",
      "delta: ${7:+3.2 over baseline}",
      "baseline: ${8:5-seed average}",
      "variant: ${9|primary,success,warning,danger,info|}",
      "---",
      "",
      "- ${10:Explain what the result means.}",
      "- ${11:Name the comparison or benchmark.}",
      "",
      "::evidence::",
      "- ${12:Dataset: AcademicBench}",
      "- ${13:Baseline: strong supervised model}",
      "",
      "$0"
    ],
    "description": "[Academic] Main-result slide with metric and evidence"
  },
  "Slidev Scholarly: Experiment Grid Layout": {
    "prefix": "ss-experiment-grid",
    "body": [
      "---",
      "layout: experiment-grid",
      "title: ${1:Experiment Grid}",
      "description: ${2:Compare experimental settings, metrics, and notes.}",
      "cols: ${3|2,3|}",
      "experiments:",
      "  - name: ${4:Ablation}",
      "    setup: ${5:Remove one module at a time}",
      "    result: ${6:-2.1}",
      "    metric: ${7:accuracy points}",
      "    note: ${8:Largest drop from routing module}",
      "  - name: ${9:Robustness}",
      "    setup: ${10:Evaluate across shifted domains}",
      "    result: ${11:+1.4}",
      "    metric: ${12:macro F1}",
      "    note: ${13:Stable under moderate shift}",
      "---",
      "",
      "${14:Optional note about experimental controls or evaluation protocol.}",
      "",
      "$0"
    ],
    "description": "[Academic] Experiment grid for settings and metrics"
  },
  "Slidev Scholarly: Limitation Layout": {
    "prefix": "ss-limitation",
    "body": [
      "---",
      "layout: limitation",
      "title: ${1:Limitations}",
      "heading: ${2:Boundary Conditions}",
      "description: ${3:Name what the current study can and cannot support.}",
      "---",
      "",
      "::limitation::",
      "- ${4:The method assumes labeled target tasks.}",
      "- ${5:Performance under severe distribution shift remains uncertain.}",
      "",
      "::mitigation::",
      "- ${6:Report shifted-domain evaluation separately.}",
      "- ${7:Scope the claim to labeled adaptation settings.}",
      "",
      "$0"
    ],
    "description": "[Academic] Limitation and mitigation slide"
  },
  "Slidev Scholarly: Defense Question Layout": {
    "prefix": "ss-defense-question",
    "body": [
      "---",
      "layout: defense-question",
      "title: ${1:Defense Question}",
      "question: ${2:Why does the proposed method outperform the strongest baseline?}",
      "source: ${3:Committee question}",
      "---",
      "",
      "${4:The routing stage improves specialization while keeping the base representation stable.}",
      "",
      "::evidence::",
      "- ${5:Ablation shows the routing module contributes +2.1 points.}",
      "- ${6:Variance stays low across five seeds.}",
      "",
      "::followup::",
      "${7:If compute budget increases, compare against a larger teacher model.}",
      "",
      "$0"
    ],
    "description": "[Academic] Defense question with answer and evidence"
  },
  "Slidev Scholarly: Appendix Index Layout": {
    "prefix": "ss-appendix-index",
    "body": [
      "---",
      "layout: appendix-index",
      "title: ${1:Appendix}",
      "description: ${2:Fast map for backup slides and detailed evidence.}",
      "items:",
      "  - label: ${3:A1}",
      "    title: ${4:Additional Experiments}",
      "    description: ${5:Full ablation and robustness tables}",
      "    page: ${6:31}",
      "  - label: ${7:A2}",
      "    title: ${8:Implementation Details}",
      "    description: ${9:Hyperparameters, training setup, and data splits}",
      "    page: ${10:34}",
      "---",
      "",
      "${11:Optional note for backup-slide navigation.}",
      "",
      "$0"
    ],
    "description": "[Academic] Appendix index for backup slides"
  },
  "Slidev Scholarly: Compare Layout": {
    "prefix": "ss-compare",
    "body": [
      "---",
      "layout: compare",
      "title: ${1:Comparison}",
      "leftLabel: ${2:Option A}",
      "rightLabel: ${3:Option B}",
      "leftColor: ${4|red,blue,green,gray|}",
      "rightColor: ${5|green,blue,red,gray|}",
      "---",
      "",
      "### ${6:Option A Points}",
      "",
      "- ${7:Point 1}",
      "- ${8:Point 2}",
      "",
      "::right::",
      "",
      "### ${9:Option B Points}",
      "",
      "- ${10:Point 1}",
      "- ${11:Point 2}",
      "",
      "$0"
    ],
    "description": "[Academic] Side-by-side comparison"
  },
  "Slidev Scholarly: Methodology Layout": {
    "prefix": "ss-methodology",
    "body": [
      "---",
      "layout: methodology",
      "ratio: \"${1|1:1,2:1,1:2|}\"",
      "title: ${2:Methodology}",
      "---",
      "",
      "## ${3:Our Approach}",
      "",
      "${4:Method description}",
      "",
      "::right::",
      "",
      "${5:Diagram or visual}",
      "",
      "$0"
    ],
    "description": "[Academic] Research methodology"
  },
