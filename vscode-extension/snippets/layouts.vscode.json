      "  - ${2:./image2.png}",
      "captions:",
      "  - ${3:Caption 1}",
      "  - ${4:Caption 2}",
      "title: ${5:Comparison}",
      "---",
      "",
      "$0"
    ],
    "description": "[Content] Side-by-side image comparison"
